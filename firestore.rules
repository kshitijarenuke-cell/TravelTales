rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public travel guides: read-only for all users, writes disabled via client
    match /guides/{guideId} {
      allow read: if true;
      allow write: if false;
    }

    // Trips: strictly scoped to the authenticated owner
    match /trips/{tripId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Subcollection activities (if structured under trip)
      match /activities/{activityId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
      }

      // Subcollection expenses (if structured under trip)
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
      }
    }

    // Top-level activities collection
    match /activities/{activityId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Top-level expenses collection
    match /expenses/{expenseId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
