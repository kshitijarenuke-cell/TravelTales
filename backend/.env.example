# ==============================================================================
# TravelTales Backend Environment Configuration Template
# Copy this file to .env and configure values for your deployment environment.
# DO NOT commit real secrets or private keys to source control.
# ==============================================================================

# Server Port (Default: 3000 locally; in cloud hosting, PORT is provided automatically by platform)
PORT=3000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=production

# Cross-Origin Resource Sharing (CORS) Allowed Origins
# Comma-separated list of permitted web frontend domains in production.
# Wildcard domains are supported (e.g., https://*.vercel.app).
# Requests from native mobile apps (Android/iOS) without an Origin header are always permitted.
# When NODE_ENV=development, all local development origins are permitted automatically.
# Example:
ALLOWED_ORIGINS=https://traveltales.vercel.app,https://your-custom-domain.com

# ==============================================================================
# Firebase Admin SDK Credentials (Choose ONE of the 4 options below)
# ==============================================================================

# OPTION 1: File path to service-account JSON (Standard for local development)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# OPTION 2: Inline or Base64-encoded Service Account JSON (Recommended for cloud PaaS: Render, Railway, Vercel)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"traveltales-bc94a","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxx@traveltales-bc94a.iam.gserviceaccount.com"}

# OPTION 3: Individual Environment Variables (Alternative for platforms with multi-line secret support)
# FIREBASE_PROJECT_ID=traveltales-bc94a
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@traveltales-bc94a.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...-----END PRIVATE KEY-----\n"

# OPTION 4: Google Application Default Credentials (Standard for Google Cloud Run / Compute Engine)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
